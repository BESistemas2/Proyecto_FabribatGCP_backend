# =====================================================================
# Variables del backend Fabribat.
# - Local (uvicorn): copia este archivo como .env  (NO se sube a git).
# - Docker / Portainer: cárgalas en el stack ("Load variables from .env file");
#   Portainer las guarda como stack.env y el docker-compose.yml las lee de ahí.
# IMPORTANTE: Docker no admite comentarios al final de la línea; déjalos en su propia línea.
# Las marcadas [OBLIGATORIA] no tienen valor por defecto: sin ellas la API no arranca.
# =====================================================================

# --- Aplicación ---
# production | development
APP_ENV=production
LOG_LEVEL=INFO
# true para habilitar /docs (Swagger)
ENABLE_DOCS=false
# Origen del frontend (varios separados por coma). Debe ser el dominio público con https
CORS_ORIGINS=https://conciliacion.fabribat.com
# Procesos de uvicorn
WEB_CONCURRENCY=2

# --- Google Secret Manager (opcional) ---
# Si se define, cada variable [OBLIGATORIA] que quede vacía aquí se lee del
# secreto con el MISMO nombre (ej. PG_S_PASSWORD) en este proyecto de GCP.
# Las variables definidas aquí tienen prioridad sobre Secret Manager.
GCP_PROJECT_ID=
# Prefijo opcional del nombre del secreto (ej. FABRIBAT_ -> FABRIBAT_PG_S_PASSWORD)
GSM_SECRET_PREFIX=
# Ruta DENTRO del contenedor al JSON de la cuenta de servicio (rol Secret Manager
# Secret Accessor). En una VM de GCP se puede omitir: usa la cuenta de la VM.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json

# --- Autenticación ---
# [OBLIGATORIA] mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=8
# [OBLIGATORIA] mismo Client ID OAuth de Google que usa el frontend
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=bateriasecuador.com

# --- PostgreSQL ---
# [OBLIGATORIA] En la VM de GCP: nombre del contenedor (misma red Docker web-network)
PG_G_HOST=postgres_db
PG_G_PORT=5432
# [OBLIGATORIA] usuario propio de la aplicación (recomendado: no usar postgres)
PG_G_USER=
# [OBLIGATORIA]
PG_S_PASSWORD=
PG_G_DB=fabribat_db
PG_G_SCHEMA=bancos,conciliacion,public
# disable | prefer | require. Dentro de la red Docker de la VM: prefer.
# Si la BD se accede por Internet (IP pública): require.
PG_G_SSLMODE=prefer
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=5

# --- MinIO ---
# [OBLIGATORIA] host:puerto. En la VM de GCP: servicio "minio" de la red minio-cs-apps_default
# (no usar el nombre del contenedor minio_server: MinIO rechaza hosts con guion bajo)
MINIO_G_ENDPOINT=minio:9000
# [OBLIGATORIA]
MINIO_S_ACCESS_KEY=
# [OBLIGATORIA]
MINIO_S_SECRET_KEY=
MINIO_G_BUCKET_COBRANZAS=appsheet-cobranzas-files
# true si MinIO se publica con HTTPS
MINIO_G_SECURE=false

# --- Business Central (Azure AD) ---
# [OBLIGATORIA]
BC_S_AZURE_CLIENT_ID=
# [OBLIGATORIA]
BC_S_AZURE_CLIENT_SECRET=
# [OBLIGATORIA]
BC_S_AZURE_TENANT_ID=
BC_G_ENV_PRD=Production
BC_G_COMPANY_NAME=FABRIBAT
# Opcional: por defecto el ID actual de la empresa FABRIBAT
# BC_G_COMPANY_ID=

# --- Correo SMTP ---
# [OBLIGATORIA]
SMTP_HOST=
# 465 = SSL directo, 587 = STARTTLS
SMTP_PORT=465
# [OBLIGATORIA]
SMTP_USER=
# [OBLIGATORIA]
SMTP_PASSWORD=
SMTP_FROM_NAME=Conciliación Fabribat
# Dominios permitidos para enviar informes (separados por coma)
EMAIL_DOMINIOS_PERMITIDOS=bateriasecuador.com,fabribat.com
