# Normaliza: en el repositorio todo se guarda con LF (Windows puede usar CRLF localmente)
* text=auto
# Archivos que Docker/Linux leen: siempre LF aunque se editen en Windows
Dockerfile text eol=lf
.dockerignore text eol=lf
*.yml text eol=lf
*.env text eol=lf
.env.example text eol=lf
*.sh text eol=lf
