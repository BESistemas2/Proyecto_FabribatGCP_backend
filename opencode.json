{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "**/secret_*.json": "deny",
      "**/service-account-*.json": "deny",
      "Claude outputs/*": "deny",
      "*.xlsx": "deny",
      "*.xls": "deny",
      "*.csv": "deny",
      "*.pdf": "deny",
      "*.dump": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env*": "deny",
      "**/*.env*": "deny",
      "opencode.json": "deny",
      "AGENTS.md": "ask",
      "migrations/*": "ask",
      "deploy/*": "deny",
      "Dockerfile": "ask",
      "docker-compose.yml": "ask",
      "requirements.txt": "ask"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git switch*": "allow",
      "git checkout -b cobranzas/*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "ruff*": "allow",
      "git push*": "ask",
      "git push * main*": "deny",
      "git reset --hard*": "deny",
      "rm *": "deny",
      "cat *env*": "deny",
      "type *env*": "deny",
      "Get-Content *env*": "deny",
      "env": "deny",
      "printenv*": "deny",
      "set": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "Invoke-WebRequest*": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "psql*": "deny",
      "mysql*": "deny",
      "docker *": "deny",
      "gcloud *": "deny",
      "gsutil *": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  }
}
